DATABASE_URL=postgresql://inspector:inspector_local@localhost:5432/container_inspection?schema=public
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional ingestion key: sent only by Python as X-API-Key, never by the dashboard.
INGEST_API_KEY=
# Set all four to enable real SMS. Empty values disable SMS in local development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_PHONE_NUMBERS=
